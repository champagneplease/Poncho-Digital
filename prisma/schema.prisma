// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMINISTRADOR
  ARTESANO
  POSTULANTE
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model Usuario {
  id           String     @id @default(uuid()) @db.Uuid
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  nombre       String
  email        String     @unique
  passwordHash String
  rol          Rol        @default(ARTESANO)
  activo       Boolean    @default(true)
  ultimoAcceso DateTime?

  artesano     Artesano?
  solicitudes  Solicitud[]
}

model Localidad {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  nombre    String
  provincia String?
  artesanos Artesano[]
}

model Ubicacion {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  pabellon  String
  sector    String
  stands    Stand[]
}

model Artesano {
  id           String      @id @default(uuid()) @db.Uuid
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  nombre       String
  apellido     String?
  telefono     String?
  estado       String      @default("PENDIENTE")

  usuarioId    String?     @unique @db.Uuid
  usuario      Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  localidadId  Int?
  localidad    Localidad?  @relation(fields: [localidadId], references: [id])
  productos    Producto[]
  stand        Stand?
  solicitudes  Solicitud[]
}

model Solicitud {
  id          Int             @id @default(autoincrement())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  estado      EstadoSolicitud @default(PENDIENTE)
  motivo      String?

  usuarioId   String          @db.Uuid
  usuario     Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  artesanoId  String?         @db.Uuid
  artesano    Artesano?       @relation(fields: [artesanoId], references: [id], onDelete: Cascade)
}

model Producto {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  nombre      String
  precio      Float
  artesanoId  String?   @db.Uuid 
  artesano    Artesano? @relation(fields: [artesanoId], references: [id], onDelete: Cascade)
}

model Stand {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  estado      String     @default("disponible")    
  coordenadas String?
  
  ubicacionId Int
  ubicacion   Ubicacion  @relation(fields: [ubicacionId], references: [id])
  
  artesanoId  String?    @unique @db.Uuid
  artesano    Artesano?  @relation(fields: [artesanoId], references: [id], onDelete: SetNull)
}

model TokenRevocado {
  jti     String   @id
  venceEn DateTime
  @@index([venceEn])
}
