// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Localidad {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  nombre    String
  provincia String?
  artesanos Artesano[]
}

model Ubicacion {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  pabellon  String
  sector    String
  stands    Stand[]
}

model Artesano {
  id           String     @id @default(uuid()) @db.Uuid
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  nombre       String
  apellido     String?
  telefono     String?
  estado       String     @default("PENDIENTE")
  localidadId  Int?
  localidad    Localidad? @relation(fields: [localidadId], references: [id])
  productos    Producto[]
  stand        Stand?
  
  // --- Autenticación ---
  email        String     @unique
  passwordHash String
  activo       Boolean    @default(true)
  ultimoAcceso DateTime?
}

model Producto {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  nombre      String
  precio      Float
  artesanoId  String?   @db.Uuid 
  artesano    Artesano? @relation(fields: [artesanoId], references: [id])
}

model Stand {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  estado      String     @default("disponible")    
  coordenadas String?
  
  ubicacionId Int
  ubicacion   Ubicacion  @relation(fields: [ubicacionId], references: [id])
  
  artesanoId  String?    @unique @db.Uuid
  artesano    Artesano?  @relation(fields: [artesanoId], references: [id], onDelete: SetNull)
}

model TokenRevocado {
  jti     String   @id
  venceEn DateTime
  @@index([venceEn])
}
